From de56aad1852014d0f299892012c34b9243e84cad Mon Sep 17 00:00:00 2001
From: "tony.shih" <tony13.shih@advantech.com>
Date: Fri, 22 Aug 2025 13:20:46 +0800
Subject: [PATCH] [enet] support if-name property in enetc driver
Upstream-Status: Inappropriate

---
 drivers/net/ethernet/freescale/enetc/enetc4_pf.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/drivers/net/ethernet/freescale/enetc/enetc4_pf.c b/drivers/net/ethernet/freescale/enetc/enetc4_pf.c
index 7598b1f0037e..f03576ad5434 100644
--- a/drivers/net/ethernet/freescale/enetc/enetc4_pf.c
+++ b/drivers/net/ethernet/freescale/enetc/enetc4_pf.c
@@ -1187,6 +1187,7 @@ static int enetc4_pf_netdev_create(struct enetc_si *si)
 	struct enetc_ndev_priv *priv;
 	struct net_device *ndev;
 	int err;
+	const char *cus_ifname = NULL;
 
 	ndev = alloc_etherdev_mqs(sizeof(struct enetc_ndev_priv),
 				  si->num_tx_rings, si->num_rx_rings);
@@ -1199,6 +1200,11 @@ static int enetc4_pf_netdev_create(struct enetc_si *si)
 	if (si->pdev->rcec)
 		priv->rcec = si->pdev->rcec;
 
+	if (of_property_read_string(dev->of_node, "if-name", &cus_ifname))
+		dev_err(dev, "No specified if-name\n");
+	else
+		snprintf(ndev->name, sizeof(ndev->name), "%s", cus_ifname);
+
 	priv->ref_clk = devm_clk_get_optional(dev, "enet_ref_clk");
 	if (IS_ERR(priv->ref_clk)) {
 		dev_err(dev, "Get enet_ref_clk failed\n");
-- 
2.34.1

